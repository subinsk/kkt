# ============================================================================
#  KAUN KATEGA TAARPATI — environment
#  Copy to .env.local and fill in. Nothing here is optional unless it says so.
# ============================================================================

# ---- Agora project (Console > Project Management) --------------------------
# The NEXT_PUBLIC_ form is required: the browser needs the App ID to join the
# RTC channel, and only NEXT_PUBLIC_ vars are inlined into the client bundle.
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Agora RESTful API (Console > Developer Toolkit > RESTful API) ---------
# Used to start/stop the agent and to call /speak and /interrupt.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ---- Public origin that Agora and Vobiz can both reach --------------------
# Agora's cloud fetches /api/llm from here; Vobiz fetches the answer_url.
# localhost is invisible to both.
#   npx cloudflared tunnel --url http://localhost:3000
# Restarting the tunnel changes this URL and SILENTLY breaks every webhook.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ---- Sarvam (dashboard.sarvam.ai) -----------------------------------------
# One key drives both legs: Saaras for ASR and Bulbul for TTS.
SARVAM_API_KEY=
# Voice for the host. Male: abhilash, karun, hitesh.
# Female: anushka, manisha, vidya, arya.
SARVAM_TTS_SPEAKER=abhilash
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PITCH=-0.1
SARVAM_TTS_PACE=0.95
# "unknown" enables auto language detection — this is the Hinglish
# code-switching lever. Set to hi-IN only if detection misbehaves in the hall.
SARVAM_ASR_LANGUAGE=unknown
ASR_LANGUAGE=hi-IN

# ---- The brain behind the custom LLM proxy --------------------------------
# Judges answers semantically and drives the tool loop.
#
# Groq is the default, because this is a voice game show under a countdown and
# time-to-first-token is what the room actually feels. Every Groq model supports
# tool calling and the API is OpenAI-compatible, so no adapter is involved.
LLM_PROVIDER=groq
LLM_UPSTREAM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
# llama-3.3-70b-versatile is the balanced default: decent Hindi, parallel tool
# calls, fast. If Hinglish disappoints in rehearsal try qwen/qwen3.6-27b, which
# tends to be stronger multilingual. Both support tools.
LLM_MODEL=llama-3.3-70b-versatile

# Quality failover, if an open model struggles with answer judging or Hinglish.
# Flip these three and restart the dev server — no code change.
#   LLM_PROVIDER=anthropic
#   LLM_UPSTREAM_URL=https://api.anthropic.com/v1/messages
#   LLM_MODEL=claude-sonnet-5

# ---- Vobiz (console.vobiz.ai) — the Phone a Friend lifeline ---------------
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# A number you actually own on Vobiz. E.164 without the plus.
VOBIZ_FROM_NUMBER=
# Fallback number for the lifeline when a contestant did not give one, and the
# number to use for your own pre-event test call.
FALLBACK_FRIEND_NUMBER=

# ---- Barge-in tuning (retune in the real room, at real noise levels) ------
INTERRUPT_DURATION_MS=160
SPEAKING_INTERRUPT_DURATION_MS=320
SILENCE_DURATION_MS=380

# ---- Audio playback policy (spec §2.3) -----------------------------------
# A = co-located, room speaker  (ship this)
# B = co-located, earbuds
# C = remote / full conference
NEXT_PUBLIC_AUDIO_MODE=A
